<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ArchWalk.RhinoPlugin</RootNamespace>
    <AssemblyName>ArchWalk</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>ARCHWALK</AssemblyTitle>
    <Description>Architectural first-person observer placement and walk for Rhino 8.25 Windows.</Description>
    <Authors>ARCHWALK</Authors>
    <Company>ARCHWALK</Company>
    <Product>ARCHWALK</Product>
    <Copyright>Copyright (c) ARCHWALK</Copyright>
    <PackageProjectUrl>https://github.com/rnasriddinov-glitch/archwalk-rhino-8-25</PackageProjectUrl>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\plugin\</OutputPath>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <StartAction>Program</StartAction>
    <StartProgram>C:\Program Files\Rhino 825\System\Rhino.exe</StartProgram>
    <StartWorkingDirectory>$(MSBuildProjectDirectory)</StartWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArchWalk.Core\ArchWalk.Core.csproj" />
    <ProjectReference Include="..\ArchWalk.WindowsInput\ArchWalk.WindowsInput.csproj" />
  </ItemGroup>
</Project>
